# ==============================================================================
# DailyVerse AI — Production Environment Configuration Template
# Copy this file to .env or set these environment variables in your deployment platform
# (Cloudflare Pages / Vercel / Netlify / Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Project Settings -> API)
# Can be named VITE_SUPABASE_URL (for client bundle) or SUPABASE_URL (for server runtime)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Public Anon Key (safe for client & browser)
# Can be named VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY, or SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (SERVER-ONLY — NEVER expose to frontend)
# Required for server-side admin operations & background automation
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. OPENAI API CONFIGURATION
# ------------------------------------------------------------------------------
# OpenAI API Key for GPT-4o-mini & DALL-E 3 image generation
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Optional AI Gateway or custom OpenAI base URL
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 3. PINTEREST DEVELOPER APP CONFIGURATION
# ------------------------------------------------------------------------------
# Pinterest OAuth 2.0 App credentials from https://developers.pinterest.com
PINTEREST_CLIENT_ID="your_pinterest_client_id"
PINTEREST_CLIENT_SECRET="your_pinterest_client_secret"
PINTEREST_REDIRECT_URI="https://yourdomain.com/api/pinterest/callback"

# Optional static access/refresh token fallback for development
# PINTEREST_ACCESS_TOKEN="your_dev_access_token"
# PINTEREST_REFRESH_TOKEN="your_dev_refresh_token"

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS SERVICE ACCOUNT CONFIGURATION
# ------------------------------------------------------------------------------
# Service Account client email from GCP IAM & Admin
GOOGLE_SHEETS_CLIENT_EMAIL="service-account@your-gcp-project.iam.gserviceaccount.com"

# Service Account RSA Private Key (replace newlines with \n)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Default Target Google Spreadsheet ID
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_spreadsheet_id"

# ------------------------------------------------------------------------------
# 5. n8n AUTOMATION & WEBHOOK SECURITY
# ------------------------------------------------------------------------------
# Secret API Key required for authenticating n8n HTTP Request nodes (x-api-key or Bearer)
N8N_API_KEY="your_secure_n8n_api_key"
